{% extends "layouts/dashboard.twig" %}

{% block dashboard_content %}
<!-- Preview Header & Controls -->
<div class="row align-items-center mb-4">
    <div class="col">
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="page-title h2 fw-bold text-dark mb-0">Preview: {{ invitation.title }}</h2>
            {% if invitation.status == 'published' %}
                <span class="badge bg-success-lt"><span class="status-dot status-dot-animated bg-success me-1"></span> Terpublikasi</span>
            {% elseif invitation.status == 'draft' %}
                <span class="badge bg-secondary-lt"><span class="status-dot bg-secondary me-1"></span> Draft</span>
            {% else %}
                <span class="badge bg-warning-lt"><span class="status-dot bg-warning me-1"></span> Nonaktif</span>
            {% endif %}
        </div>
        <div class="text-muted small">
            Periksa tampilan undangan pernikahan sebelum dibagikan kepada para tamu.
        </div>
    </div>
    <div class="col-auto ms-auto">
        <div class="btn-list">
            <a href="{{ url('/dashboard/invitations/' ~ invitation.id ~ '/edit') }}" class="btn btn-outline-primary d-inline-flex align-items-center">
                <i class="ti ti-edit me-1"></i> Edit Undangan
            </a>
            {% if invitation.status == 'published' %}
                <a href="{{ url('/i/' ~ invitation.slug) }}" target="_blank" class="btn btn-primary d-inline-flex align-items-center">
                    <i class="ti ti-external-link me-1"></i> Buka Halaman Publik
                </a>
            {% endif %}
        </div>
    </div>
</div>

<!-- URL Share Banner -->
{% if invitation.status == 'published' %}
    <div class="card bg-primary-lt border-primary-subtle shadow-xs mb-4">
        <div class="card-body py-3">
            <div class="row align-items-center">
                <div class="col-auto">
                    <span class="avatar bg-primary text-white rounded"><i class="ti ti-link fs-2"></i></span>
                </div>
                <div class="col">
                    <div class="fw-semibold text-dark">Tautan Undangan Publik Anda Siap Dibagikan</div>
                    <div class="text-muted small font-monospace user-select-all">{{ url('/i/' ~ invitation.slug) }}</div>
                </div>
                <div class="col-auto">
                    <button class="btn btn-sm btn-primary" onclick="navigator.clipboard.writeText('{{ url('/i/' ~ invitation.slug) }}'); alert('Tautan berhasil disalin ke clipboard!');">
                        <i class="ti ti-copy me-1"></i> Salin Tautan
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endif %}

<!-- Preview Viewport Frame Simulator -->
<div class="card shadow-xs border-0">
    <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <span class="status-dot bg-danger me-2"></span>
            <span class="status-dot bg-warning me-2"></span>
            <span class="status-dot bg-success me-3"></span>
            <span class="small font-monospace opacity-75">Invitara Live Responsive Simulator</span>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-dark active" id="btn-device-mobile" onclick="document.getElementById('preview-frame-container').style.maxWidth = '420px'; this.classList.add('active'); document.getElementById('btn-device-desktop').classList.remove('active');">
                <i class="ti ti-device-mobile me-1"></i> Ponsel (Mobile)
            </button>
            <button class="btn btn-sm btn-dark" id="btn-device-desktop" onclick="document.getElementById('preview-frame-container').style.maxWidth = '100%'; this.classList.add('active'); document.getElementById('btn-device-mobile').classList.remove('active');">
                <i class="ti ti-device-laptop me-1"></i> Layar Penuh (Desktop)
            </button>
        </div>
    </div>
    <div class="card-body p-4 bg-body-tertiary d-flex justify-content-center">
        <div id="preview-frame-container" class="w-100 transition-all shadow-lg rounded-4 overflow-hidden border bg-white" style="max-width: 420px; min-height: 700px; transition: max-width 0.3s ease;">
            <iframe src="{{ url('/i/' ~ invitation.slug) }}" 
                    title="Preview Undangan" 
                    class="w-100 border-0" 
                    style="height: 750px; display: block;" 
                    loading="lazy"></iframe>
        </div>
    </div>
</div>
{% endblock %}
