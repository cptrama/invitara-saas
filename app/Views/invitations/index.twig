{% extends "layouts/dashboard.twig" %}

{% block dashboard_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1">Undangan Saya</h2>
        <p class="text-muted small mb-0">Kelola seluruh undangan pernikahan digital dan pantau respons tamu Anda.</p>
    </div>
    <div>
        <a href="{{ url('/dashboard/invitations/create') }}" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Buat Undangan Baru
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title fw-bold mb-0">Daftar Undangan</h5>
        <span class="badge bg-light text-dark">{{ invitations|length }} Undangan</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Judul &amp; Mempelai</th>
                        <th>Template</th>
                        <th>Tanggal Acara</th>
                        <th>Status</th>
                        <th>Respons RSVP</th>
                        <th class="text-end pe-3">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    {% for inv in invitations %}
                        <tr>
                            <td class="ps-3">
                                <div class="fw-bold text-dark">{{ inv.title }}</div>
                                <div class="small text-muted">
                                    <i class="bi bi-heart-fill text-danger me-1"></i>
                                    {{ inv.partner_one_name }} &amp; {{ inv.partner_two_name }}
                                </div>
                                {% if inv.status == 'published' %}
                                    <div class="mt-1">
                                        <a href="{{ url('/i/' ~ inv.slug) }}" target="_blank" class="small text-decoration-none text-primary">
                                            <i class="bi bi-link-45deg"></i> /i/{{ inv.slug }}
                                        </a>
                                    </div>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">{{ inv.template_name }}</span>
                            </td>
                            <td>
                                <div>{{ inv.event_date }}</div>
                                {% if inv.event_time %}
                                    <div class="small text-muted">{{ inv.event_time }} ({{ inv.timezone }})</div>
                                {% endif %}
                            </td>
                            <td>
                                {{ status_chip(inv.status) }}
                            </td>
                            <td>
                                <a href="{{ url('/dashboard/invitations/' ~ inv.id ~ '/rsvps') }}" class="text-decoration-none">
                                    <div class="fw-semibold text-dark">{{ inv.total_rsvps }} respons</div>
                                    <div class="small text-muted">{{ inv.total_attending_guests }} orang hadir</div>
                                </a>
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    {% if inv.status == 'published' %}
                                        <a href="{{ url('/i/' ~ inv.slug) }}" target="_blank" class="btn btn-outline-success" title="Lihat Undangan Publik">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    {% endif %}
                                    <a href="{{ url('/dashboard/invitations/' ~ inv.id ~ '/edit') }}" class="btn btn-outline-primary" title="Edit Undangan">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="{{ url('/dashboard/invitations/' ~ inv.id ~ '/rsvps') }}" class="btn btn-outline-info" title="Manajemen RSVP">
                                        <i class="bi bi-people"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger" title="Hapus Undangan" data-bs-toggle="modal" data-bs-target="#deleteModal{{ inv.id }}">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <!-- Modal Konfirmasi Hapus -->
                                <div class="modal fade" id="deleteModal{{ inv.id }}" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content text-start">
                                            <div class="modal-header">
                                                <h5 class="modal-title fw-bold text-danger">Konfirmasi Hapus Undangan</h5>
                                                <button type="button" class="btn-close" data-bs-toggle="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p>Apakah Anda yakin ingin menghapus undangan <strong>"{{ inv.title }}"</strong>?</p>
                                                <p class="text-muted small mb-0">Seluruh data terkait termasuk galeri foto dan konfirmasi RSVP tamu akan dihapus permanen.</p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                                                <form action="{{ url('/dashboard/invitations/' ~ inv.id ~ '/delete') }}" method="POST" class="d-inline">
                                                    {{ csrf_field() }}
                                                    <button type="submit" class="btn btn-danger btn-sm">Ya, Hapus Undangan</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                <h5>Belum ada undangan</h5>
                                <p class="text-muted small">Mulai rancang undangan pernikahan digital pertama Anda sekarang!</p>
                                <a href="{{ url('/dashboard/invitations/create') }}" class="btn btn-primary btn-sm mt-2">
                                    <i class="bi bi-plus-lg me-1"></i> Buat Undangan Baru
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
