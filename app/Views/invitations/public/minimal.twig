{% extends "layouts/base.twig" %}

{% block content %}
<style>
    :root {
        {% if invitation.theme_color == 'emerald' %}
            --inv-accent: #2d6a4f;
            --inv-accent-light: #d8f3dc;
            --inv-text: #1b4332;
        {% elseif invitation.theme_color == 'gold' %}
            --inv-accent: #b5838d;
            --inv-accent-light: #faedcd;
            --inv-text: #6b4f4f;
        {% elseif invitation.theme_color == 'classic' %}
            --inv-accent: #212529;
            --inv-accent-light: #e9ecef;
            --inv-text: #212529;
        {% elseif invitation.theme_color == 'blue' %}
            --inv-accent: #1d3557;
            --inv-accent-light: #e0fbfc;
            --inv-text: #1d3557;
        {% elseif invitation.theme_color == 'purple' %}
            --inv-accent: #6a4c93;
            --inv-accent-light: #f3e8ee;
            --inv-text: #4a2870;
        {% else %}
            --inv-accent: #9d4edd;
            --inv-accent-light: #fbeaf0;
            --inv-text: #8338ec;
        {% endif %}
    }
    .minimal-wrap {
        max-width: 680px;
        margin: 0 auto;
        background: #ffffff;
        min-height: 100vh;
        box-shadow: 0 10px 40px rgba(0,0,0,0.06);
    }
    .minimal-hero {
        padding: 5rem 1.5rem 4rem;
        text-align: center;
        border-bottom: 1px solid #f0f0f0;
    }
    .font-serif {
        font-family: Georgia, 'Times New Roman', serif;
    }
    .text-accent {
        color: var(--inv-accent) !important;
    }
    .bg-accent {
        background-color: var(--inv-accent) !important;
        color: #fff;
    }
    .bg-accent-subtle {
        background-color: var(--inv-accent-light) !important;
    }
    .btn-accent {
        background-color: var(--inv-accent);
        color: #fff;
        border: none;
    }
    .btn-accent:hover {
        background-color: var(--inv-accent);
        opacity: 0.9;
        color: #fff;
    }
    .countdown-box {
        display: inline-flex;
        gap: 1rem;
        justify-content: center;
    }
    .countdown-item {
        background: var(--inv-accent-light);
        padding: 0.75rem 1rem;
        border-radius: 8px;
        min-width: 65px;
        text-align: center;
    }
</style>

{% include "components/wedding_interactive.twig" with {theme: 'minimal'} %}

<div class="minimal-wrap" id="top">
    <!-- Hero / Header -->
    <header class="minimal-hero">
        <p class="text-uppercase tracking-widest text-muted small mb-2" style="letter-spacing: 3px;">The Wedding Celebration Of</p>
        <h1 class="font-serif display-4 fw-normal text-accent my-3">
            {{ invitation.partner_one_name }}
            <span class="d-block fs-3 my-1 font-serif text-muted">&amp;</span>
            {{ invitation.partner_two_name }}
        </h1>
        <p class="lead text-dark mt-3 mb-0">{{ invitation.title }}</p>
        <hr class="w-25 mx-auto my-4 text-muted">
        <div class="fs-5 fw-light text-secondary">
            <i class="bi bi-calendar-event text-accent me-1"></i>
            {{ invitation.event_date|date("l, d F Y") }}
            {% if invitation.event_time %}
                <span class="d-block mt-1 small">
                    <i class="bi bi-clock text-accent me-1"></i>
                    Pukul {{ invitation.event_time }} {{ invitation.timezone }}
                </span>
            {% endif %}
        </div>
    </header>

    <div class="p-4 p-md-5">
        {% include "components/alerts.twig" %}

        <!-- Countdown Timer -->
        <div class="text-center my-4 py-3 bg-light rounded-4">
            <p class="text-muted small text-uppercase fw-semibold mb-3" style="letter-spacing: 1px;">Menghitung Hari Bahagia</p>
            <div class="countdown-box" id="countdown">
                <div class="countdown-item">
                    <span class="fs-3 fw-bold d-block text-accent" id="days">0</span>
                    <span class="small text-muted">Hari</span>
                </div>
                <div class="countdown-item">
                    <span class="fs-3 fw-bold d-block text-accent" id="hours">0</span>
                    <span class="small text-muted">Jam</span>
                </div>
                <div class="countdown-item">
                    <span class="fs-3 fw-bold d-block text-accent" id="minutes">0</span>
                    <span class="small text-muted">Menit</span>
                </div>
                <div class="countdown-item">
                    <span class="fs-3 fw-bold d-block text-accent" id="seconds">0</span>
                    <span class="small text-muted">Detik</span>
                </div>
            </div>
        </div>

        {% include "components/wedding_couple.twig" %}

        <!-- Love Story / Description -->
        {% if invitation.description %}
            <section class="text-center my-5 py-3">
                <i class="bi bi-quote fs-1 text-accent d-block mb-1"></i>
                <h4 class="font-serif fw-bold text-accent mb-3">Kisah Cinta Kami</h4>
                <p class="text-muted fst-italic px-md-4 lh-lg mb-0">
                    {{ invitation.description|nl2br }}
                </p>
            </section>
        {% endif %}

        <!-- Venue / Acara -->
        <section id="venue" class="my-5 text-center">
            <div class="card border-0 bg-accent-subtle rounded-4 p-4 text-center">
                <i class="bi bi-geo-alt-fill fs-2 text-accent mb-2"></i>
                <h4 class="font-serif fw-bold text-accent mb-2">Lokasi &amp; Waktu Acara</h4>
                {% if invitation.venue_name %}
                    <h5 class="fw-bold text-dark mt-2 mb-1">{{ invitation.venue_name }}</h5>
                {% endif %}
                {% if invitation.venue_address %}
                    <p class="text-muted mb-3">{{ invitation.venue_address|nl2br }}</p>
                {% endif %}

                {% if invitation.maps_url %}
                    <div class="mt-2">
                        <a href="{{ invitation.maps_url }}" target="_blank" class="btn btn-accent px-4 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-pin-map-fill me-1"></i> Buka Petunjuk Arah di Google Maps
                        </a>
                    </div>
                {% endif %}
            </div>
        </section>

        <!-- Closing Message -->
        {% if invitation.closing_message %}
            <section class="my-5 text-center px-3">
                <p class="text-secondary lh-lg mb-0 font-serif fst-italic">
                    "{{ invitation.closing_message|nl2br }}"
                </p>
                <div class="fw-bold text-accent mt-3">
                    Kami yang berbahagia,<br>
                    <span class="fs-5">{{ invitation.partner_one_name }} &amp; {{ invitation.partner_two_name }}</span>
                </div>
            </section>
        {% endif %}

        {% include "components/wedding_gift.twig" %}

        <!-- Form RSVP -->
        <section id="rsvp" class="my-5 pt-3">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="text-center mb-4">
                    <span class="badge bg-accent-subtle text-accent px-3 py-1 rounded-pill mb-2">Konfirmasi Kehadiran</span>
                    <h3 class="font-serif fw-bold text-dark mb-1">RSVP Tamu Undangan</h3>
                    <p class="text-muted small">Mohon konfirmasikan kehadiran Anda pada formulir di bawah ini.</p>
                </div>

                <form action="{{ url('/i/' ~ invitation.slug ~ '/rsvp') }}" method="POST">
                    {{ csrf_field() }}

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nama Lengkap Anda <span class="text-danger">*</span></label>
                        <input type="text" name="guest_name" class="form-control" placeholder="Tuliskan nama lengkap Anda" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Konfirmasi Kehadiran <span class="text-danger">*</span></label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="attendance_status" id="attend_yes" value="attending" checked onchange="toggleGuestCount(true)">
                                <label class="btn btn-outline-success w-100 py-2" for="attend_yes">
                                    <i class="bi bi-check-circle me-1"></i> Hadir
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="attendance_status" id="attend_no" value="not_attending" onchange="toggleGuestCount(false)">
                                <label class="btn btn-outline-danger w-100 py-2" for="attend_no">
                                    <i class="bi bi-x-circle me-1"></i> Tidak Hadir
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3" id="guestCountBox">
                        <label class="form-label fw-semibold">Jumlah Orang Hadir</label>
                        <input type="number" name="guest_count" id="guestCountInput" class="form-control" min="1" max="10" value="1">
                        <div class="form-text">Termasuk Anda dan pasangan/keluarga yang mendampingi.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Ucapan &amp; Doa Restu (Opsional)</label>
                        <textarea name="message" class="form-control" rows="3" placeholder="Tuliskan doa atau ucapan selamat bagi kedua mempelai..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-accent w-100 py-2 rounded-pill fw-bold shadow-sm">
                        <i class="bi bi-send-fill me-1"></i> Kirim Konfirmasi RSVP
                    </button>
                </form>
            </div>
        </section>

        <!-- Wishes Stream / Buku Tamu -->
        <section class="my-5">
            <h4 class="font-serif fw-bold text-center text-dark mb-4">
                <i class="bi bi-chat-heart text-accent me-1"></i>
                Ucapan &amp; Doa Restu ({{ rsvps|length }})
            </h4>

            <div class="d-flex flex-column gap-3">
                {% for rsvp in rsvps %}
                    <div class="card border-0 shadow-sm rounded-3 p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark">{{ rsvp.guest_name }}</span>
                            {% if rsvp.attendance_status == 'attending' %}
                                <span class="badge bg-success small"><i class="bi bi-check me-1"></i>Hadir ({{ rsvp.guest_count }} orang)</span>
                            {% else %}
                                <span class="badge bg-secondary small"><i class="bi bi-x me-1"></i>Tidak Hadir</span>
                            {% endif %}
                        </div>
                        {% if rsvp.message %}
                            <p class="text-secondary small mb-1 lh-base">{{ rsvp.message|nl2br }}</p>
                        {% endif %}
                        <div class="text-muted small" style="font-size: 0.75rem;">
                            {{ rsvp.created_at|date("d M Y, H:i") }}
                        </div>
                    </div>
                {% else %}
                    <div class="text-center text-muted py-4">
                        <p class="small mb-0">Belum ada ucapan. Jadilah yang pertama memberikan doa restu!</p>
                    </div>
                {% endfor %}
            </div>
        </section>
    </div>

    <!-- Footer -->
    <footer class="text-center py-4 border-top text-muted small">
        Undangan dibuat dengan cinta melalui <a href="{{ url('/') }}" target="_blank" class="text-accent text-decoration-none fw-semibold">Invitara</a>
    </footer>
</div>

<script>
    function toggleGuestCount(isAttending) {
        const box = document.getElementById('guestCountBox');
        const input = document.getElementById('guestCountInput');
        if (isAttending) {
            box.style.display = 'block';
            input.value = 1;
        } else {
            box.style.display = 'none';
            input.value = 0;
        }
    }

    // Countdown Timer
    (function() {
        const targetDate = new Date("{{ invitation.event_date }}T{{ invitation.event_time ? invitation.event_time : '09:00:00' }}").getTime();

        function updateCountdown() {
            const now = new Date().getTime();
            const distance = targetDate - now;

            if (distance < 0) {
                document.getElementById('countdown').innerHTML = "<div class='text-accent fw-bold fs-5 py-2'>Acara Telah Berlangsung</div>";
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById('days').innerText = days;
            document.getElementById('hours').innerText = hours;
            document.getElementById('minutes').innerText = minutes;
            document.getElementById('seconds').innerText = seconds;
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);
    })();
</script>
{% endblock %}
