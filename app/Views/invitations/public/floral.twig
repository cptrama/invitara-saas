{% extends "layouts/base.twig" %}

{% block content %}
<style>
    :root {
        --floral-primary: #b5838d;
        --floral-secondary: #e5989b;
        --floral-bg: #fffbf9;
        --floral-card: #ffffff;
        --floral-accent: #6d6875;
    }
    body {
        background-color: var(--floral-bg);
    }
    .floral-container {
        max-width: 680px;
        margin: 0 auto;
        background: var(--floral-card);
        min-height: 100vh;
        box-shadow: 0 15px 35px rgba(181, 131, 141, 0.12);
        border-left: 1px solid #f7ece9;
        border-right: 1px solid #f7ece9;
    }
    .floral-header {
        background: linear-gradient(180deg, #ffedea 0%, var(--floral-card) 100%);
        padding: 5rem 1.5rem 3.5rem;
        text-align: center;
        border-bottom: 2px dashed #f2d4ce;
    }
    .floral-ornament {
        font-size: 2.5rem;
        color: var(--floral-primary);
    }
    .font-script {
        font-family: 'Brush Script MT', 'Great Vibes', cursive, Georgia, serif;
    }
    .font-serif {
        font-family: Georgia, 'Times New Roman', serif;
    }
    .text-floral {
        color: var(--floral-primary) !important;
    }
    .bg-floral {
        background-color: var(--floral-primary) !important;
        color: #fff;
    }
    .bg-floral-subtle {
        background-color: #ffedea !important;
    }
    .btn-floral {
        background: linear-gradient(135deg, var(--floral-primary) 0%, var(--floral-secondary) 100%);
        color: #fff;
        border: none;
    }
    .btn-floral:hover {
        opacity: 0.92;
        color: #fff;
    }
    .countdown-card {
        background: #fff5f2;
        border: 1px solid #f2d4ce;
        border-radius: 16px;
        padding: 1rem;
    }
</style>

{% include "components/wedding_interactive.twig" with {theme: 'floral'} %}

<div class="floral-container" id="top">
    <!-- Floral Header -->
    <header class="floral-header">
        <div class="floral-ornament mb-2">🌿 🌸 🌿</div>
        <p class="text-uppercase text-muted small fw-semibold" style="letter-spacing: 2px;">Walimatul 'Ursy / Pernikahan</p>
        <h1 class="display-3 font-serif text-floral my-3">
            {{ invitation.partner_one_name }}
            <div class="fs-2 my-1 text-muted font-script">&amp;</div>
            {{ invitation.partner_two_name }}
        </h1>
        <p class="lead text-dark mt-2 mb-0">{{ invitation.title }}</p>
        
        <div class="mt-4 pt-2">
            <span class="badge bg-floral-subtle text-floral px-3 py-2 rounded-pill fs-6">
                <i class="bi bi-calendar4-heart me-1"></i> {{ invitation.event_date|date("l, d F Y") }}
            </span>
            {% if invitation.event_time %}
                <div class="text-muted small mt-2">
                    <i class="bi bi-clock me-1"></i> Pukul {{ invitation.event_time }} {{ invitation.timezone }}
                </div>
            {% endif %}
        </div>
    </header>

    <div class="p-4 p-md-5">
        {% include "components/alerts.twig" %}

        <!-- Countdown -->
        <div class="countdown-card text-center my-4" id="countdown">
            <p class="text-floral small fw-bold text-uppercase mb-3">Menuju Hari Bahagia</p>
            <div class="d-flex justify-content-center gap-3" id="floralCountdown">
                <div class="p-2 px-3 bg-white rounded-3 shadow-sm text-center">
                    <span class="fs-3 fw-bold text-floral d-block" id="fDays">0</span>
                    <span class="small text-muted">Hari</span>
                </div>
                <div class="p-2 px-3 bg-white rounded-3 shadow-sm text-center">
                    <span class="fs-3 fw-bold text-floral d-block" id="fHours">0</span>
                    <span class="small text-muted">Jam</span>
                </div>
                <div class="p-2 px-3 bg-white rounded-3 shadow-sm text-center">
                    <span class="fs-3 fw-bold text-floral d-block" id="fMinutes">0</span>
                    <span class="small text-muted">Menit</span>
                </div>
                <div class="p-2 px-3 bg-white rounded-3 shadow-sm text-center">
                    <span class="fs-3 fw-bold text-floral d-block" id="fSeconds">0</span>
                    <span class="small text-muted">Detik</span>
                </div>
            </div>
        </div>

        {% include "components/wedding_couple.twig" %}

        <!-- Story -->
        {% if invitation.description %}
            <section class="my-5 text-center px-md-3">
                <h4 class="font-serif fw-bold text-floral mb-3">🌺 Cerita Kami</h4>
                <p class="text-secondary lh-lg mb-0 font-serif fst-italic">
                    {{ invitation.description|nl2br }}
                </p>
            </section>
        {% endif %}

        <!-- Venue -->
        <section id="venue" class="my-5">
            <div class="card border-0 bg-floral-subtle rounded-4 p-4 text-center">
                <i class="bi bi-geo-alt fs-2 text-floral mb-2"></i>
                <h4 class="font-serif fw-bold text-floral mb-2">Tempat &amp; Alamat Acara</h4>
                {% if invitation.venue_name %}
                    <h5 class="fw-bold text-dark mt-2 mb-1">{{ invitation.venue_name }}</h5>
                {% endif %}
                {% if invitation.venue_address %}
                    <p class="text-muted mb-3">{{ invitation.venue_address|nl2br }}</p>
                {% endif %}

                {% if invitation.maps_url %}
                    <div>
                        <a href="{{ invitation.maps_url }}" target="_blank" class="btn btn-floral px-4 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-map me-1"></i> Buka Petunjuk Arah
                        </a>
                    </div>
                {% endif %}
            </div>
        </section>

        <!-- Closing Note -->
        {% if invitation.closing_message %}
            <section class="my-5 text-center px-3">
                <p class="text-secondary lh-lg mb-0 font-serif">
                    "{{ invitation.closing_message|nl2br }}"
                </p>
                <div class="fw-bold text-floral mt-3 font-serif">
                    Salam hangat dari kami,<br>
                    <span class="fs-5">{{ invitation.partner_one_name }} &amp; {{ invitation.partner_two_name }}</span>
                </div>
            </section>
        {% endif %}

        {% include "components/wedding_gift.twig" %}

        <!-- RSVP Form -->
        <section id="rsvp" class="my-5 pt-3">
            <div class="card border-0 shadow-sm rounded-4 p-4" style="border: 1px solid #f2d4ce !important;">
                <div class="text-center mb-4">
                    <span class="badge bg-floral-subtle text-floral px-3 py-1 rounded-pill mb-2">Konfirmasi Kehadiran</span>
                    <h3 class="font-serif fw-bold text-dark mb-1">Formulir RSVP</h3>
                    <p class="text-muted small">Kehadiran serta doa restu Anda adalah kebahagiaan bagi kami.</p>
                </div>

                <form action="{{ url('/i/' ~ invitation.slug ~ '/rsvp') }}" method="POST">
                    {{ csrf_field() }}

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nama Lengkap Tamu <span class="text-danger">*</span></label>
                        <input type="text" name="guest_name" class="form-control" placeholder="Tuliskan nama Anda" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Apakah Anda Berkenan Hadir? <span class="text-danger">*</span></label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="attendance_status" id="floral_attend_yes" value="attending" checked onchange="toggleGuestFloral(true)">
                                <label class="btn btn-outline-success w-100 py-2" for="floral_attend_yes">
                                    <i class="bi bi-heart-fill me-1"></i> Ya, Hadir
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="attendance_status" id="floral_attend_no" value="not_attending" onchange="toggleGuestFloral(false)">
                                <label class="btn btn-outline-danger w-100 py-2" for="floral_attend_no">
                                    <i class="bi bi-x-circle me-1"></i> Berhalangan
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3" id="floralGuestCountBox">
                        <label class="form-label fw-semibold">Jumlah Tamu yang Hadir</label>
                        <input type="number" name="guest_count" id="floralGuestCountInput" class="form-control" min="1" max="10" value="1">
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Ucapan &amp; Doa Restu (Opsional)</label>
                        <textarea name="message" class="form-control" rows="3" placeholder="Sampaikan ucapan hangat Anda..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-floral w-100 py-2 rounded-pill fw-bold shadow-sm">
                        <i class="bi bi-send-fill me-1"></i> Kirim Konfirmasi RSVP
                    </button>
                </form>
            </div>
        </section>

        <!-- Wishes -->
        <section class="my-5">
            <h4 class="font-serif fw-bold text-center text-floral mb-4">
                🌸 Doa &amp; Ucapan Tamu ({{ rsvps|length }})
            </h4>

            <div class="d-flex flex-column gap-3">
                {% for rsvp in rsvps %}
                    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white" style="border-left: 4px solid var(--floral-primary) !important;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-dark">{{ rsvp.guest_name }}</span>
                            {% if rsvp.attendance_status == 'attending' %}
                                <span class="badge bg-success small">Hadir ({{ rsvp.guest_count }})</span>
                            {% else %}
                                <span class="badge bg-secondary small">Tidak Hadir</span>
                            {% endif %}
                        </div>
                        {% if rsvp.message %}
                            <p class="text-secondary small mb-1 lh-base">{{ rsvp.message|nl2br }}</p>
                        {% endif %}
                        <div class="text-muted small" style="font-size: 0.75rem;">
                            {{ rsvp.created_at|date("d M Y, H:i") }}
                        </div>
                    </div>
                {% else %}
                    <div class="text-center text-muted py-4">
                        <p class="small mb-0">Belum ada ucapan doa. Jadilah yang pertama mengisi!</p>
                    </div>
                {% endfor %}
            </div>
        </section>
    </div>

    <!-- Footer -->
    <footer class="text-center py-4 border-top text-muted small">
        Undangan digital manis dipersembahkan melalui <a href="{{ url('/') }}" target="_blank" class="text-floral text-decoration-none fw-semibold">Invitara</a>
    </footer>
</div>

<script>
    function toggleGuestFloral(isAttending) {
        const box = document.getElementById('floralGuestCountBox');
        const input = document.getElementById('floralGuestCountInput');
        if (isAttending) {
            box.style.display = 'block';
            input.value = 1;
        } else {
            box.style.display = 'none';
            input.value = 0;
        }
    }

    (function() {
        const targetDate = new Date("{{ invitation.event_date }}T{{ invitation.event_time ? invitation.event_time : '09:00:00' }}").getTime();

        function updateCountdown() {
            const now = new Date().getTime();
            const distance = targetDate - now;

            if (distance < 0) {
                document.getElementById('floralCountdown').innerHTML = "<div class='text-floral fw-bold fs-5 py-2'>Acara Telah Berlangsung</div>";
                return;
            }

            document.getElementById('fDays').innerText = Math.floor(distance / (1000 * 60 * 60 * 24));
            document.getElementById('fHours').innerText = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            document.getElementById('fMinutes').innerText = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            document.getElementById('fSeconds').innerText = Math.floor((distance % (1000 * 60)) / 1000);
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);
    })();
</script>
{% endblock %}
