{% extends "layouts/public.twig" %}

{% block public_content %}
<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4 p-md-5 my-5 rounded-4">
                <div class="mb-4">
                    <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Belum Dipublikasikan
                    </span>
                </div>
                <h1 class="h3 fw-bold text-dark mb-3">Undangan Belum Tersedia</h1>
                <p class="text-muted mb-4">
                    Undangan pernikahan ini saat ini masih berstatus <strong>{{ invitation.status }}</strong> atau belum dipublikasikan oleh pihak mempelai/penyelenggara.
                </p>
                <div>
                    <a href="{{ url('/') }}" class="btn btn-outline-primary px-4">
                        <i class="bi bi-house me-1"></i> Kembali ke Beranda
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
