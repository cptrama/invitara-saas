{% extends "layouts/base.twig" %}

{% block content %}
<style>
    :root {
        --modern-dark: #0f172a;
        --modern-card: #1e293b;
        --modern-accent: #38bdf8;
        --modern-subtle: #334155;
        --modern-text: #f8fafc;
    }
    body {
        background-color: #0b1120;
        color: #e2e8f0;
    }
    .modern-wrap {
        max-width: 680px;
        margin: 0 auto;
        background: #0f172a;
        min-height: 100vh;
        border-left: 1px solid #1e293b;
        border-right: 1px solid #1e293b;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    }
    .modern-hero {
        padding: 5rem 1.5rem 4rem;
        text-align: center;
        background: radial-gradient(circle at top, #1e293b 0%, #0f172a 100%);
        border-bottom: 1px solid #334155;
    }
    .text-modern {
        color: var(--modern-accent) !important;
    }
    .btn-modern {
        background: var(--modern-accent);
        color: #0f172a;
        border: none;
        font-weight: 600;
    }
    .btn-modern:hover {
        background: #7dd3fc;
        color: #0f172a;
    }
    .modern-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 16px;
    }
    .modern-timer-box {
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        min-width: 65px;
        text-align: center;
    }
</style>

{% include "components/wedding_interactive.twig" with {theme: 'modern'} %}

<div class="modern-wrap" id="top">
    <!-- Hero -->
    <header class="modern-hero">
        <span class="badge bg-dark border border-secondary text-modern px-3 py-1 rounded-pill mb-3">
            WEDDING INVITATION
        </span>
        <h1 class="display-4 fw-bold text-white mb-2" style="letter-spacing: -1px;">
            {{ invitation.partner_one_name }}
            <span class="text-modern d-block fs-3 my-1">&amp;</span>
            {{ invitation.partner_two_name }}
        </h1>
        <p class="text-light opacity-75 mt-2 mb-0">{{ invitation.title }}</p>

        <div class="mt-4">
            <div class="fs-5 fw-semibold text-white">
                <i class="bi bi-calendar3 text-modern me-1"></i>
                {{ invitation.event_date|date("l, d F Y") }}
            </div>
            {% if invitation.event_time %}
                <div class="small text-muted mt-1">
                    <i class="bi bi-clock text-modern me-1"></i>
                    {{ invitation.event_time }} {{ invitation.timezone }}
                </div>
            {% endif %}
        </div>
    </header>

    <div class="p-4 p-md-5">
        {% include "components/alerts.twig" %}

        <!-- Countdown -->
        <div class="modern-card p-4 text-center my-4" id="countdown">
            <div class="text-muted small text-uppercase fw-bold mb-3" style="letter-spacing: 2px;">COUNTDOWN</div>
            <div class="d-flex justify-content-center gap-2 gap-md-3" id="modernCountdown">
                <div class="modern-timer-box">
                    <span class="fs-3 fw-bold text-modern d-block" id="mDays">0</span>
                    <span class="small text-muted">Hari</span>
                </div>
                <div class="modern-timer-box">
                    <span class="fs-3 fw-bold text-modern d-block" id="mHours">0</span>
                    <span class="small text-muted">Jam</span>
                </div>
                <div class="modern-timer-box">
                    <span class="fs-3 fw-bold text-modern d-block" id="mMinutes">0</span>
                    <span class="small text-muted">Menit</span>
                </div>
                <div class="modern-timer-box">
                    <span class="fs-3 fw-bold text-modern d-block" id="mSeconds">0</span>
                    <span class="small text-muted">Detik</span>
                </div>
            </div>
        </div>

        {% include "components/wedding_couple.twig" %}

        <!-- Story -->
        {% if invitation.description %}
            <section class="my-5 text-center px-md-3">
                <h4 class="fw-bold text-white mb-3">Our Story</h4>
                <p class="text-light opacity-75 lh-lg mb-0">
                    {{ invitation.description|nl2br }}
                </p>
            </section>
        {% endif %}

        <!-- Location -->
        <section id="venue" class="my-5">
            <div class="modern-card p-4 text-center">
                <i class="bi bi-geo-alt-fill fs-2 text-modern mb-2"></i>
                <h4 class="fw-bold text-white mb-2">Event Location</h4>
                {% if invitation.venue_name %}
                    <h5 class="fw-bold text-modern mt-2 mb-1">{{ invitation.venue_name }}</h5>
                {% endif %}
                {% if invitation.venue_address %}
                    <p class="text-light opacity-75 mb-3">{{ invitation.venue_address|nl2br }}</p>
                {% endif %}

                {% if invitation.maps_url %}
                    <div>
                        <a href="{{ invitation.maps_url }}" target="_blank" class="btn btn-modern px-4 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-cursor-fill me-1"></i> Google Maps
                        </a>
                    </div>
                {% endif %}
            </div>
        </section>

        <!-- Closing Note -->
        {% if invitation.closing_message %}
            <section class="my-5 text-center px-3">
                <p class="text-light opacity-75 lh-lg mb-0 fst-italic">
                    "{{ invitation.closing_message|nl2br }}"
                </p>
                <div class="fw-bold text-modern mt-3">
                    Warm Regards,<br>
                    <span class="fs-5 text-white">{{ invitation.partner_one_name }} &amp; {{ invitation.partner_two_name }}</span>
                </div>
            </section>
        {% endif %}

        {% include "components/wedding_gift.twig" %}

        <!-- RSVP -->
        <section id="rsvp" class="my-5 pt-3">
            <div class="modern-card p-4">
                <div class="text-center mb-4">
                    <span class="badge bg-dark border border-secondary text-modern px-3 py-1 rounded-pill mb-2">RSVP CONFIRMATION</span>
                    <h3 class="fw-bold text-white mb-1">Konfirmasi Kehadiran</h3>
                    <p class="text-muted small">Beri tahu kami apakah Anda dapat menghadiri momen spesial ini.</p>
                </div>

                <form action="{{ url('/i/' ~ invitation.slug ~ '/rsvp') }}" method="POST">
                    {{ csrf_field() }}

                    <div class="mb-3">
                        <label class="form-label text-white fw-semibold">Nama Lengkap <span class="text-danger">*</span></label>
                        <input type="text" name="guest_name" class="form-control bg-dark text-white border-secondary" placeholder="Tuliskan nama Anda" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-white fw-semibold">Status Kehadiran <span class="text-danger">*</span></label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="attendance_status" id="modern_attend_yes" value="attending" checked onchange="toggleGuestModern(true)">
                                <label class="btn btn-outline-info w-100 py-2" for="modern_attend_yes">
                                    <i class="bi bi-check-lg me-1"></i> Hadir
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="attendance_status" id="modern_attend_no" value="not_attending" onchange="toggleGuestModern(false)">
                                <label class="btn btn-outline-secondary w-100 py-2" for="modern_attend_no">
                                    <i class="bi bi-x-lg me-1"></i> Tidak Hadir
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3" id="modernGuestCountBox">
                        <label class="form-label text-white fw-semibold">Jumlah Tamu Hadir</label>
                        <input type="number" name="guest_count" id="modernGuestCountInput" class="form-control bg-dark text-white border-secondary" min="1" max="10" value="1">
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-white fw-semibold">Ucapan &amp; Pesan (Opsional)</label>
                        <textarea name="message" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Tuliskan ucapan selamat Anda..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-modern w-100 py-2 rounded-pill fw-bold">
                        <i class="bi bi-send me-1"></i> Submit RSVP
                    </button>
                </form>
            </div>
        </section>

        <!-- Wishes -->
        <section class="my-5">
            <h4 class="fw-bold text-center text-white mb-4">
                <i class="bi bi-chat-dots text-modern me-1"></i>
                Wishes &amp; Prayers ({{ rsvps|length }})
            </h4>

            <div class="d-flex flex-column gap-3">
                {% for rsvp in rsvps %}
                    <div class="modern-card p-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-white">{{ rsvp.guest_name }}</span>
                            {% if rsvp.attendance_status == 'attending' %}
                                <span class="badge bg-info text-dark small">Hadir ({{ rsvp.guest_count }})</span>
                            {% else %}
                                <span class="badge bg-secondary small">Tidak Hadir</span>
                            {% endif %}
                        </div>
                        {% if rsvp.message %}
                            <p class="text-light opacity-75 small mb-1 lh-base">{{ rsvp.message|nl2br }}</p>
                        {% endif %}
                        <div class="text-muted small" style="font-size: 0.75rem;">
                            {{ rsvp.created_at|date("d M Y, H:i") }}
                        </div>
                    </div>
                {% else %}
                    <div class="text-center text-muted py-4">
                        <p class="small mb-0">Belum ada ucapan. Jadilah yang pertama mengirimkan ucapan!</p>
                    </div>
                {% endfor %}
            </div>
        </section>
    </div>

    <!-- Footer -->
    <footer class="text-center py-4 border-top border-secondary text-muted small">
        Powered by <a href="{{ url('/') }}" target="_blank" class="text-modern text-decoration-none fw-semibold">Invitara</a>
    </footer>
</div>

<script>
    function toggleGuestModern(isAttending) {
        const box = document.getElementById('modernGuestCountBox');
        const input = document.getElementById('modernGuestCountInput');
        if (isAttending) {
            box.style.display = 'block';
            input.value = 1;
        } else {
            box.style.display = 'none';
            input.value = 0;
        }
    }

    (function() {
        const targetDate = new Date("{{ invitation.event_date }}T{{ invitation.event_time ? invitation.event_time : '09:00:00' }}").getTime();

        function updateCountdown() {
            const now = new Date().getTime();
            const distance = targetDate - now;

            if (distance < 0) {
                document.getElementById('modernCountdown').innerHTML = "<div class='text-modern fw-bold fs-5 py-2'>Event Concluded</div>";
                return;
            }

            document.getElementById('mDays').innerText = Math.floor(distance / (1000 * 60 * 60 * 24));
            document.getElementById('mHours').innerText = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            document.getElementById('mMinutes').innerText = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            document.getElementById('mSeconds').innerText = Math.floor((distance % (1000 * 60)) / 1000);
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);
    })();
</script>
{% endblock %}
