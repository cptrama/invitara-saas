{% extends "layouts/dashboard.twig" %}

{% block dashboard_content %}
<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a href="{{ url('/dashboard') }}" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="{{ url('/dashboard/invitations') }}" class="text-decoration-none">Undangan Saya</a></li>
            <li class="breadcrumb-item"><a href="{{ url('/dashboard/invitations/' ~ invitation.id ~ '/edit') }}" class="text-decoration-none">{{ invitation.title }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">Manajemen RSVP</li>
        </ol>
    </nav>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="h3 fw-bold mb-1">Manajemen RSVP &amp; Buku Tamu</h2>
            <p class="text-muted small mb-0">
                Undangan: <strong>{{ invitation.title }}</strong> ({{ invitation.partner_one_name }} &amp; {{ invitation.partner_two_name }})
            </p>
        </div>
        <div class="d-flex gap-2">
            {% if invitation.status == 'published' %}
                <a href="{{ url('/i/' ~ invitation.slug) }}" target="_blank" class="btn btn-outline-success btn-sm">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Halaman Publik
                </a>
            {% endif %}
            <a href="{{ url('/dashboard/invitations/' ~ invitation.id ~ '/edit') }}" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit Undangan
            </a>
            <a href="{{ url('/dashboard/invitations') }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Kembali ke Daftar
            </a>
        </div>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <div class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary me-2">
                        <i class="bi bi-people-fill fs-5"></i>
                    </div>
                    <span class="text-muted small fw-semibold">Total Respons</span>
                </div>
                <div class="h3 fw-bold text-dark mb-0">{{ summary.total_responses }}</div>
                <div class="small text-muted mt-1">Konfirmasi masuk</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <div class="p-2 rounded-3 bg-success bg-opacity-10 text-success me-2">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                    </div>
                    <span class="text-muted small fw-semibold">Tamu Hadir</span>
                </div>
                <div class="h3 fw-bold text-success mb-0">{{ summary.total_attending }}</div>
                <div class="small text-muted mt-1">Menyatakan hadir</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <div class="p-2 rounded-3 bg-danger bg-opacity-10 text-danger me-2">
                        <i class="bi bi-x-circle-fill fs-5"></i>
                    </div>
                    <span class="text-muted small fw-semibold">Tidak Hadir</span>
                </div>
                <div class="h3 fw-bold text-danger mb-0">{{ summary.total_not_attending }}</div>
                <div class="small text-muted mt-1">Berhalangan hadir</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <div class="p-2 rounded-3 bg-info bg-opacity-10 text-info me-2">
                        <i class="bi bi-person-check-fill fs-5"></i>
                    </div>
                    <span class="text-muted small fw-semibold">Akumulasi Orang</span>
                </div>
                <div class="h3 fw-bold text-info mb-0">{{ summary.total_attending_guests }}</div>
                <div class="small text-muted mt-1">Total estimasi tamu</div>
            </div>
        </div>
    </div>
</div>

<!-- Guest List Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title fw-bold mb-0">Daftar Tamu &amp; Pesan Ucapan</h5>
        <span class="badge bg-light text-dark border">{{ rsvps|length }} Responden</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 50px;">#</th>
                        <th>Nama Tamu</th>
                        <th>Status Kehadiran</th>
                        <th>Jumlah Hadir</th>
                        <th>Ucapan / Doa Restu</th>
                        <th>Waktu Konfirmasi</th>
                        <th class="text-end pe-3">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rsvp in rsvps %}
                        <tr>
                            <td class="ps-3 text-muted">{{ loop.index }}</td>
                            <td>
                                <div class="fw-bold text-dark">{{ rsvp.guest_name }}</div>
                            </td>
                            <td>
                                {{ status_chip(rsvp.attendance_status) }}
                            </td>
                            <td>
                                {% if rsvp.attendance_status == 'attending' %}
                                    <span class="badge bg-light text-dark border">{{ rsvp.guest_count }} orang</span>
                                {% else %}
                                    <span class="text-muted small">-</span>
                                {% endif %}
                            </td>
                            <td style="max-width: 320px;">
                                {% if rsvp.message %}
                                    <div class="text-break small text-secondary">{{ rsvp.message|nl2br }}</div>
                                {% else %}
                                    <span class="text-muted fst-italic small">Tanpa pesan</span>
                                {% endif %}
                            </td>
                            <td class="text-muted small">
                                <div>{{ rsvp.created_at|date("d/m/Y") }}</div>
                                <div style="font-size: 0.75rem;">{{ rsvp.created_at|date("H:i") }}</div>
                            </td>
                            <td class="text-end pe-3">
                                <form action="{{ url('/dashboard/invitations/' ~ invitation.id ~ '/rsvps/' ~ rsvp.id ~ '/delete') }}" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus entri RSVP dari {{ rsvp.guest_name }}?');">
                                    {{ csrf_field() }}
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus RSVP / Spam">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-chat-heart fs-1 d-block mb-2 text-secondary"></i>
                                <h5>Belum ada respons RSVP</h5>
                                <p class="text-muted small mb-0">Bagikan tautan undangan Anda agar para tamu dapat mengonfirmasi kehadiran.</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
