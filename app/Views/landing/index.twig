{% extends "layouts/public.twig" %}

{% block public_content %}
<!-- Hero Banner Section -->
<section class="hero-banner py-6 py-lg-7 border-bottom position-relative overflow-hidden">
    <div class="container-xl">
        <div class="row align-items-center g-5">
            <div class="col-lg-7 text-center text-lg-start">
                <div class="d-inline-flex align-items-center badge bg-primary-lt text-primary px-3 py-2 rounded-pill fw-semibold mb-3 shadow-xs">
                    <i class="ti ti-sparkles me-1 fs-3"></i> SaaS Wedding Digital Invitation Maker
                </div>
                <h1 class="display-4 fw-extrabold text-dark tracking-tight mb-3">
                    Create Your Moment, <br>
                    <span class="brand-gradient-text">Share Your Invitation</span>
                </h1>
                <p class="lead text-muted mb-4 col-lg-11 pe-lg-4">
                    Invitara memudahkan calon mempelai merancang undangan pernikahan digital yang memikat,
                    personal, dan elegan tanpa perlu keahlian teknis. Bagikan cerita cinta Anda dan kelola kehadiran
                    tamu (RSVP) secara praktis dalam satu tempat.
                </p>

                <div class="d-flex flex-column flex-sm-row justify-content-center justify-content-lg-start gap-3">
                    {% if is_authenticated() %}
                        <a href="{{ url('/dashboard') }}" class="btn btn-primary btn-lg px-4 d-inline-flex align-items-center justify-content-center shadow-sm">
                            <i class="ti ti-layout-dashboard me-2 fs-2"></i> Buka Dashboard Saya
                        </a>
                        <a href="{{ url('/dashboard/invitations/create') }}" class="btn btn-outline-primary btn-lg px-4 d-inline-flex align-items-center justify-content-center">
                            <i class="ti ti-plus me-1 fs-2"></i> Buat Undangan Baru
                        </a>
                    {% else %}
                        <a href="{{ url('/register') }}" class="btn btn-primary btn-lg px-4 d-inline-flex align-items-center justify-content-center shadow-sm">
                            <i class="ti ti-heart-handshake me-2 fs-2"></i> Buat Undangan Gratis
                        </a>
                        <a href="#templates" class="btn btn-outline-secondary btn-lg px-4 d-inline-flex align-items-center justify-content-center">
                            <i class="ti ti-palette me-2 fs-2"></i> Lihat Pilihan Template
                        </a>
                    {% endif %}
                </div>

                <!-- Trust Points -->
                <div class="row g-3 mt-4 text-start justify-content-center justify-content-lg-start">
                    <div class="col-auto d-flex align-items-center text-muted small">
                        <i class="ti ti-circle-check text-success me-2 fs-3"></i> 100% Responsif Mobile
                    </div>
                    <div class="col-auto d-flex align-items-center text-muted small">
                        <i class="ti ti-circle-check text-success me-2 fs-3"></i> RSVP Real-Time
                    </div>
                    <div class="col-auto d-flex align-items-center text-muted small">
                        <i class="ti ti-circle-check text-success me-2 fs-3"></i> Siap dalam 5 Menit
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <!-- Visual Showcase Card -->
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden card-hover-scale">
                    <div class="card-header bg-dark text-white py-3 border-0 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <span class="avatar avatar-xs bg-primary text-white rounded me-2">
                                <i class="ti ti-mail-heart"></i>
                            </span>
                            <span class="small fw-semibold">Preview Undangan Pernikahan</span>
                        </div>
                        <span class="badge bg-success-lt">Live Preview</span>
                    </div>
                    <div class="card-body p-4 text-center bg-body-tertiary">
                        <div class="p-4 bg-white rounded-3 shadow-xs border">
                            <div class="badge bg-pink-lt text-pink mb-2">The Wedding Of</div>
                            <h3 class="fw-bold fs-2 text-dark mb-1">Romeo &amp; Juliet</h3>
                            <div class="text-muted small mb-3">Minggu, 12 Desember 2026</div>
                            <hr class="my-3 opacity-25">
                            <p class="small text-muted fst-italic mb-3">
                                "Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir untuk memberikan doa restu."
                            </p>
                            <div class="d-flex justify-content-center gap-2">
                                <span class="badge bg-secondary-lt"><i class="ti ti-map-pin me-1"></i> Grand Ballroom</span>
                                <span class="badge bg-indigo-lt"><i class="ti ti-clock me-1"></i> 10:00 WIB</span>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white text-center py-3 border-top small text-muted">
                        <i class="ti ti-device-mobile me-1"></i> Tampilan optimal di smartphone tamu undangan
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Cara Kerja Section (3 Langkah Mudah) -->
<section id="cara-kerja" class="py-6 bg-white border-bottom">
    <div class="container-xl">
        <div class="text-center mb-5">
            <span class="badge bg-primary-lt text-primary mb-2 px-3 py-1 rounded-pill fw-semibold">Alur Praktis</span>
            <h2 class="display-6 fw-bold text-dark">3 Langkah Mudah Membuat Undangan</h2>
            <p class="text-muted col-md-6 mx-auto">
                Tanpa keahlian desain atau coding, undangan digital Anda siap disebarkan hanya dengan 3 tahap sederhana.
            </p>
        </div>

        <div class="row g-4">
            <!-- Step 1 -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-xs rounded-3 text-center p-4 card-hover-scale">
                    <div class="mb-3">
                        <span class="avatar avatar-xl bg-primary-lt text-primary rounded-circle shadow-xs">
                            <i class="ti ti-palette fs-1"></i>
                        </span>
                    </div>
                    <span class="badge bg-secondary-lt text-secondary w-auto mx-auto mb-2 font-monospace">LANGKAH 01</span>
                    <h3 class="card-title fw-bold h3 mb-2">Pilih Template Favorit</h3>
                    <p class="text-muted small mb-0">
                        Pilih beragam opsi tema pernikahan yang dirancang cantik dan modern, mulai dari gaya minimalis, floral, hingga modern kontemporer.
                    </p>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-xs rounded-3 text-center p-4 card-hover-scale">
                    <div class="mb-3">
                        <span class="avatar avatar-xl bg-pink-lt text-pink rounded-circle shadow-xs">
                            <i class="ti ti-edit fs-1"></i>
                        </span>
                    </div>
                    <span class="badge bg-secondary-lt text-secondary w-auto mx-auto mb-2 font-monospace">LANGKAH 02</span>
                    <h3 class="card-title fw-bold h3 mb-2">Isi Data &amp; Cerita Anda</h3>
                    <p class="text-muted small mb-0">
                        Lengkapi profil mempelai, rincian jadwal akad &amp; resepsi, tautan peta Google Maps, dan galeri foto momen berharga Anda.
                    </p>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-xs rounded-3 text-center p-4 card-hover-scale">
                    <div class="mb-3">
                        <span class="avatar avatar-xl bg-success-lt text-success rounded-circle shadow-xs">
                            <i class="ti ti-share fs-1"></i>
                        </span>
                    </div>
                    <span class="badge bg-secondary-lt text-secondary w-auto mx-auto mb-2 font-monospace">LANGKAH 03</span>
                    <h3 class="card-title fw-bold h3 mb-2">Sebar &amp; Pantau RSVP</h3>
                    <p class="text-muted small mb-0">
                        Bagikan link undangan ke kerabat melalui WhatsApp atau media sosial. Pantau konfirmasi kehadiran dan ucapan tamu secara langsung.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Galeri Template Preview Section -->
<section id="templates" class="py-6 bg-body-tertiary border-bottom">
    <div class="container-xl">
        <div class="text-center mb-5">
            <span class="badge bg-pink-lt text-pink mb-2 px-3 py-1 rounded-pill fw-semibold">Galeri Koleksi</span>
            <h2 class="display-6 fw-bold text-dark">Pilihan Template Wedding</h2>
            <p class="text-muted col-md-6 mx-auto">
                Setiap template dirancang khusus dengan perpaduan tipografi anggun dan keindahan visual yang memukau.
            </p>
        </div>

        <div class="row g-4">
            {% for template in templates %}
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-xs border-0 rounded-3 overflow-hidden card-hover-scale d-flex flex-column">
                        <!-- Preview Thumbnail / Mockup -->
                        <div class="bg-dark text-white p-4 text-center position-relative d-flex flex-column justify-content-center align-items-center" style="min-height: 200px; background: linear-gradient(135deg, #1e293b 0%, #334155 100%);">
                            <span class="avatar avatar-lg bg-white-lt text-white rounded-circle mb-2">
                                <i class="ti ti-photo-heart fs-1"></i>
                            </span>
                            <div class="fw-bold fs-3 text-white">{{ template.name }}</div>
                            <span class="badge bg-primary-lt mt-2">{{ template.category_name ?? 'Wedding' }}</span>
                        </div>

                        <div class="card-body d-flex flex-column p-4 flex-grow-1">
                            <h4 class="card-title fw-bold text-dark mb-2">{{ template.name }}</h4>
                            <p class="card-text text-muted small flex-grow-1 mb-3">
                                {{ template.description ?? 'Template undangan digital elegan dengan layout responsif untuk momen sakral Anda.' }}
                            </p>
                            
                            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                <span class="badge bg-secondary-lt">
                                    <i class="ti ti-layout me-1"></i> Key: {{ template.view_key ?? 'minimal' }}
                                </span>
                                {% if is_authenticated() %}
                                    <a href="{{ url('/dashboard/invitations/create') }}" class="btn btn-sm btn-primary">
                                        Pilih Template
                                    </a>
                                {% else %}
                                    <a href="{{ url('/register') }}" class="btn btn-sm btn-outline-primary">
                                        Gunakan Desain
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center text-muted py-5">
                    <div class="empty">
                        <div class="empty-icon">
                            <i class="ti ti-palette fs-1 text-secondary"></i>
                        </div>
                        <p class="empty-title">Katalog Template Sedang Diperbarui</p>
                        <p class="empty-subtitle text-muted">Daftar desain template wedding terbaru segera hadir.</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- Fitur Unggulan Section -->
<section id="fitur" class="py-6 bg-white border-bottom">
    <div class="container-xl">
        <div class="text-center mb-5">
            <span class="badge bg-primary-lt text-primary mb-2 px-3 py-1 rounded-pill fw-semibold">Keunggulan Sistem</span>
            <h2 class="display-6 fw-bold text-dark">Fitur Cerdas untuk Hari Bahagia Anda</h2>
            <p class="text-muted col-md-6 mx-auto">
                Invitara dirancang khusus untuk memberikan pengalaman terbaik baik bagi pengantin maupun tamu undangan.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 p-4 shadow-xs rounded-3 card-hover-scale">
                    <div class="avatar avatar-md bg-primary-lt text-primary rounded mb-3">
                        <i class="ti ti-device-mobile fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Desain Responsif</h4>
                    <p class="text-muted small mb-0">
                        Undangan otomatis menyesuaikan tampilan dengan mulus di smartphone, tablet, maupun layar laptop.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 p-4 shadow-xs rounded-3 card-hover-scale">
                    <div class="avatar avatar-md bg-success-lt text-success rounded mb-3">
                        <i class="ti ti-checkbox fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Konfirmasi RSVP</h4>
                    <p class="text-muted small mb-0">
                        Tamu dapat mengonfirmasi kehadiran serta jumlah pendamping secara instan tanpa perlu repot mencatat manual.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 p-4 shadow-xs rounded-3 card-hover-scale">
                    <div class="avatar avatar-md bg-pink-lt text-pink rounded mb-3">
                        <i class="ti ti-photo fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Galeri Foto Prewedding</h4>
                    <p class="text-muted small mb-0">
                        Tampilkan momen terindah perjalanan cinta Anda dengan tata letak galeri foto yang bersih dan anggun.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 p-4 shadow-xs rounded-3 card-hover-scale">
                    <div class="avatar avatar-md bg-indigo-lt text-indigo rounded mb-3">
                        <i class="ti ti-shield-lock fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Aman &amp; Terpercaya</h4>
                    <p class="text-muted small mb-0">
                        Dilengkapi proteksi keamanan CSRF, enkripsi sesi pengguna, dan kontrol hak akses kepemilikan yang ketat.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Banner -->
<section class="py-6 bg-dark text-white text-center position-relative">
    <div class="container-xl">
        <div class="col-lg-8 mx-auto">
            <span class="badge bg-primary-lt text-primary mb-3 px-3 py-2 rounded-pill fw-semibold">Mulai Hari Ini</span>
            <h2 class="display-6 fw-bold text-white mb-3">Siap Menyambut Hari Bahagia Anda?</h2>
            <p class="lead text-secondary mb-4">
                Bergabunglah bersama pasangan bahagia lainnya yang telah menyebarkan undangan pernikahan mereka dengan Invitara.
            </p>
            {% if is_authenticated() %}
                <a href="{{ url('/dashboard/invitations/create') }}" class="btn btn-primary btn-lg px-5 shadow-sm">
                    <i class="ti ti-plus me-1"></i> Buat Undangan Sekarang
                </a>
            {% else %}
                <a href="{{ url('/register') }}" class="btn btn-primary btn-lg px-5 shadow-sm">
                    <i class="ti ti-user-plus me-1"></i> Daftar Akun &amp; Buat Undangan Gratis
                </a>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
