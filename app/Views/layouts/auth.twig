{% extends "layouts/base.twig" %}

{% block body_class %}d-flex flex-column bg-body-tertiary min-vh-100{% endblock %}

{% block content %}
<div class="page page-center py-4">
    <div class="container container-tight py-4">
        <!-- Logo & Header Brand -->
        <div class="text-center mb-4">
            <a href="{{ url('/') }}" class="navbar-brand navbar-brand-autodark d-inline-flex align-items-center text-decoration-none">
                <img src="{{ asset('assets/img/logo-invitara.png') }}" alt="Logo Invitara" class="rounded-3 me-2 shadow-xs" style="width: 44px; height: 44px; object-fit: contain;">
                <span class="h1 fw-bold mb-0 text-dark tracking-tight">Invitara</span>
            </a>
            <div class="text-muted small mt-1">Wedding Digital Invitation Maker</div>
        </div>

        <!-- Flash Notification Placeholder -->
        {% include "components/alerts.twig" %}

        <!-- Card Auth Tabler -->
        <div class="card card-md shadow-sm border-0 rounded-3">
            <div class="card-body p-4 p-md-5">
                {% block auth_content %}{% endblock %}
            </div>
        </div>

        <!-- Footer Hak Cipta -->
        <div class="text-center text-secondary mt-4 small">
            &copy; {{ "now"|date("Y") }} <strong>Invitara</strong>. Hak cipta dilindungi.
        </div>
    </div>
</div>
{% endblock %}
