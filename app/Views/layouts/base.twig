<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <title>{% block title %}{{ page_title ?? 'Invitara' }}{% endblock %} - {{ app_name }}</title>

    <!-- Tabler UI & Icons via CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta20/dist/css/tabler.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.24.0/dist/tabler-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom Invitara Brand Styles -->
    <style>
        :root {
            --invitara-brand: #d946ef;
            --invitara-dark: #1e293b;
        }
        .brand-gradient-text {
            background: linear-gradient(135deg, #d946ef 0%, #8b5cf6 50%, #3b82f6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero-banner {
            background: radial-gradient(circle at top right, rgba(217, 70, 239, 0.08) 0%, transparent 60%),
                        radial-gradient(circle at bottom left, rgba(59, 130, 246, 0.08) 0%, transparent 60%);
        }
        .card-hover-scale {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }
        .card-hover-scale:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
        }
    </style>

    <!-- Optional Compiled Vite Assets -->
    <link rel="stylesheet" href="{{ asset('build/assets/app.css') }}">
    <!-- Tabler & Bootstrap Icons Webfont Fallback -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.24.0/dist/tabler-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    {% block styles %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    {% block content %}{% endblock %}

    <!-- Tabler UI & Bootstrap JS via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta20/dist/js/tabler.min.js"></script>
    <script src="{{ asset('build/assets/app.js') }}"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
