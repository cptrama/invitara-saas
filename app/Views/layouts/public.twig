{% extends "layouts/base.twig" %}

{% block content %}
<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold text-primary" href="{{ url('/') }}">
            <i class="bi bi-envelope-heart-fill me-1"></i> Invitara
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="publicNav">
            <ul class="navbar-nav ms-auto align-items-center">
                {% if is_authenticated() %}
                    <li class="nav-item me-2">
                        <a href="{{ url('/dashboard') }}" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-grid-fill me-1"></i> Dashboard
                        </a>
                    </li>
                {% else %}
                    <li class="nav-item me-2">
                        <a href="{{ url('/login') }}" class="nav-link">Masuk</a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ url('/register') }}" class="btn btn-primary btn-sm">Daftar Sekarang</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<main>
    {% include "components/alerts.twig" %}
    {% block public_content %}{% endblock %}
</main>

<footer class="bg-white border-top py-4 mt-5 text-center text-muted small">
    <div class="container">
        &copy; {{ "now"|date("Y") }} Invitara. Create Your Moment, Share Your Invitation.
    </div>
</footer>
{% endblock %}
