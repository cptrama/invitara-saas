{% extends "layouts/public.twig" %}

{% block public_content %}
<div class="py-5 bg-white border-bottom">
    <div class="container">
        <a href="{{ url('/templates') }}" class="btn btn-outline-secondary btn-sm mb-4">
            <i class="ti ti-arrow-left me-1"></i> Kembali ke Galeri
        </a>

        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm bg-light text-center p-5 rounded-4">
                    <div class="py-5">
                        <i class="ti ti-layout text-primary display-1"></i>
                        <h4 class="mt-4 fw-bold">{{ template.name }}</h4>
                        <span class="badge bg-primary-lt text-uppercase font-monospace px-3 py-2 mt-1">Theme: {{ template.view_key }}</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <span class="badge bg-secondary-lt text-secondary px-3 py-1 mb-2">{{ template.category_name ?? 'Wedding' }}</span>
                <h1 class="display-6 fw-bold mb-3">{{ template.name }}</h1>
                <p class="text-muted lead mb-4">
                    {{ template.description }}
                </p>

                <div class="card border-0 bg-light p-3 rounded-3 mb-4">
                    <h5 class="fw-bold mb-2"><i class="ti ti-checklist text-success me-2"></i> Keunggulan Desain:</h5>
                    <ul class="list-unstyled mb-0 small text-muted">
                        <li class="mb-1"><i class="ti ti-check text-primary me-2"></i> Tata letak adaptif dan ramah perangkat ponsel (*Mobile-first*)</li>
                        <li class="mb-1"><i class="ti ti-check text-primary me-2"></i> Dilengkapi integrasi formulir RSVP tamu online</li>
                        <li class="mb-1"><i class="ti ti-check text-primary me-2"></i> Bagian sampul, jadwal acara, peta lokasi, dan galeri foto</li>
                    </ul>
                </div>

                <div class="d-flex gap-3">
                    {% if is_authenticated() %}
                        <a href="{{ url('/dashboard/invitations/create?template=' ~ template.id) }}" class="btn btn-primary btn-lg px-4">
                            <i class="ti ti-circle-plus me-2"></i> Buat Undangan dengan Template Ini
                        </a>
                    {% else %}
                        <a href="{{ url('/register') }}" class="btn btn-primary btn-lg px-4">
                            <i class="ti ti-sparkles me-2"></i> Daftar &amp; Buat Undangan
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
