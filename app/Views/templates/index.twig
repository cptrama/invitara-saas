{% extends "layouts/public.twig" %}

{% block public_content %}
<div class="py-5 bg-light border-bottom">
    <div class="container text-center">
        <span class="badge bg-primary-lt text-primary px-3 py-2 rounded-pill fw-semibold mb-2">Desain Eksklusif</span>
        <h1 class="fw-bold display-6 mb-2">Galeri Template Undangan Pernikahan</h1>
        <p class="text-muted lead fs-4 mx-auto" style="max-width: 650px;">
            Pilih dari berbagai pilihan desain pernikahan elegan dan modern yang siap digunakan untuk momen istimewa Anda.
        </p>
    </div>
</div>

<div class="py-5">
    <div class="container">
        <div class="row g-4">
            {% for template in templates %}
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                        <div class="position-relative bg-secondary-subtle d-flex align-items-center justify-content-center" style="height: 220px;">
                            <i class="ti ti-heart-handshake text-muted display-4"></i>
                            <span class="position-absolute top-0 end-0 m-3 badge bg-white text-dark shadow-xs border">
                                {{ template.category_name ?? 'Wedding' }}
                            </span>
                        </div>
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h4 class="card-title fw-bold text-dark mb-0">{{ template.name }}</h4>
                                <span class="badge bg-blue-lt text-uppercase font-monospace small">{{ template.view_key }}</span>
                            </div>
                            <p class="card-text text-muted small flex-grow-1 mb-4">
                                {{ template.description ?? 'Template undangan digital elegan dan responsif.' }}
                            </p>
                            <div class="d-flex gap-2">
                                <a href="{{ url('/templates/' ~ template.slug) }}" class="btn btn-outline-secondary btn-sm flex-fill">
                                    <i class="ti ti-eye me-1"></i> Detail
                                </a>
                                {% if is_authenticated() %}
                                    <a href="{{ url('/dashboard/invitations/create?template=' ~ template.id) }}" class="btn btn-primary btn-sm flex-fill">
                                        <i class="ti ti-check me-1"></i> Pilih Template
                                    </a>
                                {% else %}
                                    <a href="{{ url('/register') }}" class="btn btn-primary btn-sm flex-fill">
                                        <i class="ti ti-sparkles me-1"></i> Buat Undangan
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center text-muted py-5">
                    <i class="ti ti-inbox fs-1 d-block mb-2 text-secondary"></i>
                    Belum ada template aktif yang tersedia saat ini.
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
