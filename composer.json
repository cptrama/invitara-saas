{
    "name": "invitara/invitara-saas",
    "description": "Invitara - Wedding Digital Invitation Maker (SaaS)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2.0",
        "flightphp/core": "^3.12",
        "twig/twig": "^3.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
